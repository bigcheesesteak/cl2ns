# Carelink credentials (from Token Generator or token login script)
CARELINK_TOKEN=your_access_token_jwt_here
CARELINK_REFRESH_TOKEN=your_refresh_token_here
CARELINK_CLIENT_ID=your_client_id_here
# CARELINK_CLIENT_SECRET=         # Optional, only used for legacy CA MAG gateways
# CARELINK_PATIENT_ID=            # Optional, auto-detected if account has one active patient
# CARELINK_MAG_IDENTIFIER=        # Optional, legacy CA MAG only

# Nightscout
NIGHTSCOUT_URL=https://your-nightscout-instance.example.com
NIGHTSCOUT_API_SECRET=your_nightscout_api_secret_here

# Sync settings
SYNC_INTERVAL=60                  # Base sync cadence in seconds (default: 60)
LOG_LEVEL=INFO                    # INFO, DEBUG, WARNING, ERROR
# TZ=America/New_York             # Optional IANA timezone override (e.g. UTC, America/New_York)
