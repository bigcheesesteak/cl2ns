# Carelink credentials (from Token Generator add-on or mobile app OAuth flow)
CARELINK_TOKEN=your_access_token_jwt_here
CARELINK_REFRESH_TOKEN=your_refresh_token_here
CARELINK_CLIENT_ID=your_client_id_here
CARELINK_CLIENT_SECRET=               # Optional, leave empty if not available
# CARELINK_PATIENT_ID=               # Only needed for care partner accounts
# CARELINK_MAG_IDENTIFIER=           # Legacy, usually not needed

# Nightscout
NIGHTSCOUT_URL=https://your-nightscout-instance.example.com
NIGHTSCOUT_API_SECRET=your_nightscout_api_secret_here

# Sync settings
SYNC_INTERVAL=300                     # Base sync cadence in seconds (default: 300)
LOG_LEVEL=INFO                        # INFO, DEBUG, WARNING, ERROR
# TIMEZONE=Europe/Brussels            # Optional IANA timezone override
